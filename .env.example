# ─── Database (Neon) ───────────────────────────────────────────────
# Pooled connection string (used by the app)
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"
# Direct (non-pooled) connection string (used by `prisma migrate`)
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"

# ─── Auth (Better Auth + Google) ───────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET=""
# Origin users see, no path (the app lives at /connextlearning; see BASE_PATH in src/lib/urls.ts).
# Local development: http://localhost:3000
BETTER_AUTH_URL="https://tratcouncil.com"
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Comma-separated admin accounts
ADMIN_EMAILS="27192@tkschool.ac.th"

# ─── Cloudflare R2 (private bucket) ────────────────────────────────
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET="connext-learning"

# ─── News page (Instagram) ─────────────────────────────────────────
# Long-lived token of the Instagram account (Instagram API with Instagram Login).
# It is refreshed automatically and stored in the database after first use.
INSTAGRAM_ACCESS_TOKEN=""
INSTAGRAM_USERNAME="doodee.future"
