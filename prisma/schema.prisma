generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Auth (tables required by Better Auth)
// ---------------------------------------------------------------------------

enum Role {
  USER
  ADMIN
}

enum MemberType {
  STUDENT // กำลังศึกษา
  ALUMNI // ศิษย์เก่า
  TEACHER // ครู
}

model User {
  id            String    @id
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  role          Role      @default(USER)

  // First-sign-in registration (/register); null registeredAt = not registered yet.
  // Personal data: never shown publicly (the public name stays `name`).
  registeredAt  DateTime?
  prefix        String? // เด็กชาย, เด็กหญิง, นาย, นางสาว, นาง
  firstName     String?
  lastName      String?
  memberType    MemberType?
  grade         Grade? // students
  room          Int? // students
  studentNo     Int? // students: เลขที่
  birthDate     DateTime? @db.Date // alumni
  gradYear      Int? // alumni: academic year of graduation (พ.ศ.)
  department    String? // teachers: กลุ่มสาระการเรียนรู้ (see DEPARTMENTS)
  teachGrades   Grade[] // teachers: levels they teach
  // Optional public contact links shown on the profile ({ instagram: "name", … }, see src/lib/contacts.ts)
  contacts      Json?

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  sessions      Session[]
  accounts      Account[]

  sheets        Sheet[]     @relation("SheetAuthor")
  reviewed      Sheet[]     @relation("SheetReviewer")
  views         SheetView[]
  ratings       Rating[]
  comments      Comment[]

  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model RateLimit {
  id          String @id
  key         String @unique
  count       Int
  lastRequest BigInt

  @@map("rateLimit")
}

// ---------------------------------------------------------------------------
// Sheets
// ---------------------------------------------------------------------------

enum SheetStatus {
  PENDING
  APPROVED
  REJECTED
  HIDDEN // approved earlier, taken off the public site by an admin
}

enum Grade {
  M1
  M2
  M3
  M4
  M5
  M6
}

enum CoverMode {
  SUBJECT // each subject uses its own cover
  UNIFORM // every sheet uses the same cover
}

model Subject {
  id        String  @id // slug, e.g. "math"
  name      String
  sortOrder Int     @default(0)
  // R2 key prefix of a custom cover ("covers/<uuid>"); null = built-in default
  coverKey  String?
  sheets    Sheet[]
}

model SiteSetting {
  id              Int       @id @default(1)
  coverMode       CoverMode @default(SUBJECT)
  uniformCoverKey String?
  // Instagram long-lived token for the news page (auto-refreshed; seeded from INSTAGRAM_ACCESS_TOKEN)
  igAccessToken    String?
  igTokenExpiresAt DateTime?
  // Admin-uploaded videos in R2 ("videos/<uuid>.mp4|webm", served by /media)
  newsVideoKey     String? // top of the news page
  homeVideoKey     String? // landing page after the hero: landscape 16:9 (computers, tablets)
  homeVideoMobileKey String? // the same spot on phones: portrait 9:16 (falls back to homeVideoKey)
  // Admin-set site icon and link-preview image (R2 prefix "covers/<uuid>"; null = built-in)
  faviconKey       String?
  ogImageKey       String?
  updatedAt       DateTime  @updatedAt
}

// Landing-page banner carousel (2000×600 artwork), ordered by sortOrder
model Banner {
  id        String   @id @default(cuid())
  imageKey  String // R2 key prefix "covers/<uuid>" (-2000.webp / -1000.webp)
  linkUrl   String?
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  @@index([sortOrder])
}

// Admin-chosen artwork (4:5) of a "sheets by grade" tile on the landing page; no row = built-in image
model HomeImage {
  slot     Int    @id // 1–8, see GRADE_ART
  imageKey String // R2 key prefix "covers/<uuid>"
}

// News categories, managed by admins (NewsPost.category stores the name)
model NewsCategory {
  id        String   @id @default(cuid())
  name      String   @unique
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
}

// Admin-managed news cards on the news page
model NewsPost {
  id          String   @id @default(cuid())
  title       String
  summary     String
  linkUrl     String?
  // Text of the popup button that opens linkUrl (null = "รายละเอียดเพิ่มเติม")
  linkLabel   String?
  category    String? // NewsCategory.name (null = uncategorised)
  // R2 key prefix ("covers/<uuid>", served by /media); null = no image
  imageKey    String?
  publishedAt DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([publishedAt(sort: Desc)])
}

model Sheet {
  id           String      @id @default(cuid())
  title        String
  description  String
  subjectId    String
  subject      Subject     @relation(fields: [subjectId], references: [id])
  grade        Grade
  semester     Int
  academicYear Int

  status       SheetStatus @default(PENDING)
  rejectReason String?

  // Admin-chosen cover for this sheet only (overrides subject / uniform cover)
  coverKey     String?

  // Merged PDF kept privately in R2; readers get a short-lived signed link
  pdfKey       String
  pdfBytes     Int
  pageCount    Int

  viewCount    Int         @default(0)

  authorId     String
  author       User        @relation("SheetAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  reviewedById String?
  reviewedBy   User?       @relation("SheetReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt   DateTime?
  publishedAt  DateTime?

  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  views        SheetView[]
  ratings      Rating[]
  comments     Comment[]

  @@index([status, publishedAt(sort: Desc)])
  @@index([status, viewCount(sort: Desc)])
  @@index([status, subjectId])
  @@index([status, grade])
  @@index([status, academicYear, semester])
  @@index([authorId, createdAt(sort: Desc)])
}

// One row per (sheet, user) so the view counter counts unique readers
model SheetView {
  sheetId   String
  userId    String
  createdAt DateTime @default(now())
  sheet     Sheet    @relation(fields: [sheetId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([sheetId, userId])
  @@index([userId])
}

// One star rating (1–5) per (sheet, user); rating again replaces the score
model Rating {
  sheetId   String
  userId    String
  score     Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  sheet     Sheet    @relation(fields: [sheetId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([sheetId, userId])
  @@index([userId])
}

model Comment {
  id        String   @id @default(cuid())
  body      String
  sheetId   String
  userId    String
  createdAt DateTime @default(now())
  sheet     Sheet    @relation(fields: [sheetId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([sheetId, createdAt(sort: Desc)])
  @@index([userId, createdAt])
}

// Visits per day (Asia/Bangkok) for the footer: each browser counts once a day, nothing personal is stored
model SiteVisit {
  day   DateTime @id @db.Date
  count Int      @default(0)
}
